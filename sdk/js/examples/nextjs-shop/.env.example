# Where toshi-way's API lives (the server's address).
TOSHI_URL=http://127.0.0.1:3000
# An API key with both scopes: API page, then API keys. Shown once.
TOSHI_KEY=tk_...
# The signing secret of your webhook: API page, then Webhooks. Shown once.
TOSHI_WHSEC=whsec_...
# This shop's own public address. The customer is sent back here after accepting.
APP_URL=http://localhost:3200
# Only if the toshi-way server has no public web address of its own (a local test setup): the address of
# its web app, used to build the checkout link.
# TOSHI_WEB_URL=http://localhost:3001
